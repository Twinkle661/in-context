{
  "name": "in-context",
  "version": "0.1.0",
  "description": "pi extension: session-level system prompt sections and per-request ephemeral tail context, from static text, files or REST endpoints.",
  "type": "module",
  "license": "MIT",
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
