  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "^1.6.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0"
  },
  "files": [
    "index.ts",
    "src",
    "config.example.json",
    "README.md"
  ]
}
